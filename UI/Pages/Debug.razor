@page "/debug"
@inject IJSRuntime Js

<PageTitle>App diagnostics</PageTitle>

<section class="app-debug-page">
    <header class="app-debug-header">
        <div>
            <h1>App diagnostics</h1>
            <p>Reproduce the crash, reopen the app, then return here and copy the report.</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="GoBack" title="Return to the previous screen">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back
        </button>
    </header>

    <div class="app-debug-actions">
        <button class="btn btn-primary" @onclick="LoadReport" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            Refresh
        </button>
        <button class="btn btn-outline-primary" @onclick="CopyReport" disabled="@(_loading || string.IsNullOrWhiteSpace(_report))">
            <i class="bi bi-clipboard" aria-hidden="true"></i>
            Copy
        </button>
        <button class="btn btn-outline-danger" @onclick="ClearReport" disabled="@_loading">
            <i class="bi bi-trash" aria-hidden="true"></i>
            Clear
        </button>
        @if (_copied)
        {
            <span role="status">Copied</span>
        }
    </div>

    <pre class="app-debug-report">@(_loading ? "Loading diagnostics..." : _report)</pre>
</section>

@code {
    private string _report = "";
    private bool _loading = true;
    private bool _copied;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadReport();
        }
    }

    private async Task LoadReport()
    {
        _loading = true;
        _copied = false;
        StateHasChanged();
        try
        {
            _report = await Js.InvokeAsync<string>("getAppDebugReport");
        }
        catch (Exception exception)
        {
            _report = $"Unable to load diagnostics: {exception.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CopyReport()
    {
        try
        {
            await Js.InvokeVoidAsync("copyAppDebugReport", _report);
            _copied = true;
        }
        catch (Exception exception)
        {
            _report += $"\n\nUnable to copy automatically: {exception.Message}";
        }
    }

    private async Task ClearReport()
    {
        await Js.InvokeVoidAsync("clearAppDebugReport");
        await LoadReport();
    }

    private ValueTask GoBack()
    {
        return Js.InvokeVoidAsync("history.back");
    }
}
