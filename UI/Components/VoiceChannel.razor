@using Models
@using Microsoft.AspNetCore.SignalR
@using System.Reflection
@inject SignalRStateManager SignalRStateManager
@inject State State
@inject IJSRuntime Js
@inject ILogger<VoiceChannel> Logger
@implements IAsyncDisposable

<section class="voice-channel mb-3" aria-label="Voice and video channel">
    <div class="voice-channel-header">
        <div class="voice-channel-title">
            <strong>Voice &amp; video</strong>
            @if (_joined)
            {
                <span class="voice-signal-health @SignalHealthCssClass" role="status" aria-live="polite" aria-atomic="true" title="@SignalHealthLabel">
                    <svg width="14" height="12" viewBox="0 0 14 12" aria-hidden="true" focusable="false">
                        <rect class="voice-signal-bar" x="1" y="8" width="3" height="4" rx="0.5" />
                        <rect class="voice-signal-bar" x="5" y="4" width="3" height="8" rx="0.5" />
                        <rect class="voice-signal-bar" x="9" y="0" width="3" height="12" rx="0.5" />
                    </svg>
                    <span class="visually-hidden">@SignalHealthLabel</span>
                </span>
                <span class="ms-2 text-muted">@(_participantIds.Count + 1) connected</span>
                @if (_useHttpsAudio)
                {
                    <span class="ms-2 text-muted">Audio over HTTPS (Stealth mode) - @(_opusAudio ? "Native Opus" : "Compatibility G.711")</span>
                }
                else
                {
                    <span class="ms-2 text-muted">Automatic - WebRTC</span>
                }
            }
        </div>

        <div class="voice-channel-actions">
            @if (!_joined)
            {
                <span data-stop-ringtone>
                    <HxButton Color="ThemeColor.Success" Enabled="@(!_busy)" OnClick="@(() => _incomingCallerConnectionId == null ? Join() : AcceptCall())">
                        Join call
                    </HxButton>
                </span>
            }
            else
            {
                @if (_usesAudioSessionOutputModes)
                {
                    <label class="voice-quality voice-transcription-model">
                        <span>Audio output</span>
                        <select class="form-select form-select-sm" @bind="_audioOutputMode" @bind:after="AudioOutputModeChanged">
                            <option value="auto">Auto (proximity)</option>
                            <option value="earpiece">Always earpiece</option>
                            <option value="speaker">Always speaker</option>
                        </select>
                    </label>
                }
                else if (_audioOutputSelectionSupported)
                {
                    <HxButton Color="ThemeColor.Secondary" OnClick="ChooseAudioOutput">
                        Choose output
                    </HxButton>
                }
                <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy && !_transitioning)" OnClick="ToggleMute">
                    @(_muted ? "Unmute" : "Mute")
                </HxButton>
                @if (_screenWakeLockSupported)
                {
                    <div class="form-check form-switch voice-keep-awake">
                        <input id="keep-screen-on" class="form-check-input" type="checkbox" role="switch" @bind="_keepScreenOn" @bind:after="KeepScreenOnChanged" />
                        <label class="form-check-label" for="keep-screen-on">Keep screen on</label>
                    </div>
                }
                @if (!_useHttpsAudio)
                {
                    <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy && !_screenSharing)" OnClick="ToggleVideo">
                        @(_videoEnabled ? "Stop video" : "Start video")
                    </HxButton>
                }
                @if (_screenSharingSupported || _screenSharing)
                {
                    <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy)" OnClick="ToggleScreenSharing">
                        @(_screenSharing ? "Stop sharing" : "Share screen")
                    </HxButton>
                }
                @if (_liveTranscriptionSupported || _transcriptionEnabled)
                {
                    <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy && (_transcriptionEnabled || _participantIds.Count > 0))" OnClick="ToggleTranscription">
                        @(_transcriptionEnabled ? "Stop transcription" : "Start transcription")
                    </HxButton>
                }
                <HxButton Color="ThemeColor.Danger" OnClick="Leave">
                    @(_participantIds.Count > 0 ? "End call" : "Leave call")
                </HxButton>
            }
        </div>
    </div>

    @if (_joined && !string.IsNullOrWhiteSpace(_transportReason))
    {
        <div class="text-muted mt-2" role="status">@_transportReason
            @if (_useHttpsAudio && !_opusAudio)
            {
                <span>Native Opus is not available in every participant's browser; using telephone-quality compatibility audio.</span>
            }
        </div>
    }
    <div class="voice-settings-controls mt-2">
        <HxButton Color="ThemeColor.Secondary" Enabled="@(!_checkingBrowserTurn)" OnClick="TestBrowserRelay">
            @(_checkingBrowserTurn ? "Testing relay..." : "Test TURN/TLS")
        </HxButton>
        <span class="@BrowserTurnStatusCssClass" role="status" aria-live="polite" aria-atomic="true">
            @BrowserTurnStatus
        </span>
    </div>
    @if (_browserTurnResult != null || _browserTurnError != null)
    {
        <div class="voice-health-message mt-2">
            @if (_browserTurnResult != null)
            {
                <div>@_browserTurnResult.Url - @_browserTurnResult.Message</div>
            }
            else
            {
                <div class="text-danger">@_browserTurnError</div>
            }
            <small class="text-muted">Last browser allocation test, not a continuous connection monitor or a two-way media test. Retest after changing networks.</small>
        </div>
    }

    @if (AdvancedMode && _joined && _liveTranscriptionSupported)
    {
        <small class="voice-transcription-warning text-muted">Starting transcription downloads large model files unless already cached. Wi-Fi recommended.</small>
    }

    @if (AdvancedMode)
    {
        <section class="voice-settings mt-3" aria-labelledby="voice-settings-title">
            <strong id="voice-settings-title">Advanced call settings</strong>
            <div class="voice-settings-controls mt-2">
                <div>
                    <div class="form-check form-switch">
                        <input id="https-audio-mode" class="form-check-input" type="checkbox" role="switch"
                               @bind="_forceStealth" disabled="@(_joined || _busy)" />
                        <label class="form-check-label" for="https-audio-mode">Force Audio over HTTPS (Stealth mode)</label>
                    </div>
                    <small class="text-muted">Automatic is the default: try WebRTC, then switch the whole call to encrypted HTTPS audio if media cannot connect. Enable this to skip WebRTC; other participants switch automatically. Stealth is audio-only, without video or transcription, and is not a guaranteed filtering bypass.</small>
                </div>
                <label class="voice-quality">
                    <span>Audio quality</span>
                    <select @key="_effectiveAudioQuality" class="form-select form-select-sm" @bind="_audioQuality" @bind:after="AudioQualityChanged" disabled="@(_busy || _useHttpsAudio || _forceStealth)">
                        <option value="auto">Auto - Current: @AudioQualityLabel(_effectiveAudioQuality)</option>
                        <option value="very-low">Very low</option>
                        <option value="low">Low</option>
                        <option value="standard">Medium</option>
                        <option value="high">High</option>
                    </select>
                </label>
                <label class="voice-quality">
                    <span>Camera quality</span>
                    <select @key="_effectiveVideoQuality" class="form-select form-select-sm" @bind="_videoQuality" @bind:after="VideoQualityChanged" disabled="@(_busy || _useHttpsAudio || _forceStealth)">
                        <option value="auto">Auto - Current: @VideoQualityLabel(_effectiveVideoQuality)</option>
                        <option value="very-low">Very low (144p)</option>
                        <option value="low">Low (240p)</option>
                        <option value="standard">Medium (480p)</option>
                        <option value="high">High (720p)</option>
                    </select>
                </label>
                @if (_joined && !_usesAudioSessionOutputModes && !_audioOutputSelectionSupported)
                {
                    <span class="text-muted">Audio output is managed by your browser. Speaker and earpiece selection is unavailable.</span>
                }
                @if (_joined && _liveTranscriptionSupported)
                {
                    <label class="voice-quality voice-transcription-model">
                        <span>Transcription model</span>
                        <select class="form-select form-select-sm" @bind="_transcriptionModel" disabled="@(_busy || _transcriptionEnabled)">
                            <option value="auto">Default (Auto) - Recommended: @TranscriptionModelLabel(_recommendedTranscriptionModel)</option>
                            <option value="tiny">Multilingual Tiny - Fastest, least accurate</option>
                            <option value="base">Multilingual Base - More accurate, slower</option>
                            <option value="small">Multilingual Small - Most accurate, slowest</option>
                            <option value="tiny-en">English Tiny - Fastest for English</option>
                            <option value="base-en">English Base - More accurate English, slower</option>
                            <option value="small-en">English Small - Most accurate English, slowest</option>
                        </select>
                    </label>
                }
            </div>
        </section>
    }

    @if (DebugMode)
    {
        <section class="voice-settings mt-3" aria-labelledby="voice-diagnostics-title">
            <strong id="voice-diagnostics-title">Call diagnostics</strong>
            <div class="voice-settings-controls mt-2">
                <HxButton Color="@TurnHealthColor" Enabled="@(!_checkingTurn)" OnClick="CheckTurnHealth">
                    @TurnHealthButtonText
                </HxButton>
                @if (_joined || _lastHttpsDiagnostics != null)
                {
                    <HxButton Color="ThemeColor.Secondary" OnClick="ToggleDebug">
                        @(_showDebug ? "Hide call debug" : "Call debug")
                    </HxButton>
                }
            </div>
            @if (_turnHealth != null)
            {
                <div class="@TurnHealthMessageCssClass" role="status">
                    @_turnHealth.Host:@_turnHealth.Port - @_turnHealth.Message
                </div>
            }
            else if (_turnHealthError != null)
            {
                <div class="voice-health-message mt-2 text-danger" role="alert">@_turnHealthError</div>
            }
        </section>
    }

    <div class="voice-presence mt-3">
        <strong>Online</strong>
        @if (!OtherOnlineUsers.Any())
        {
            <span class="text-muted">No one else is online</span>
        }
        else
        {
            @foreach (var user in OtherOnlineUsers)
            {
                <div class="voice-online-user">
                    <span>@user.Name</span>
                    @if (user.HttpsAudio)
                    {
                        <span class="text-muted">Stealth audio</span>
                    }
                    @if (_participantIds.Contains(user.ConnectionId))
                    {
                        <span class="text-success">In call</span>
                    }
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Primary" Enabled="@(!_busy && _outgoingCallConnectionId == null)" OnClick="@(() => Ring(user))">
                        Ring
                    </HxButton>
                </div>
            }
        }
    </div>

    @if (_incomingCallerConnectionId != null)
    {
        <div class="voice-call-alert mt-3" role="alert">
            <strong>@_incomingCallerName is calling</strong>
            <div data-stop-ringtone>
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Success" Enabled="@(!_busy)" OnClick="AcceptCall">
                    Accept
                </HxButton>
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Danger" Enabled="@(!_busy)" OnClick="DeclineCall">
                    Decline
                </HxButton>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_callStatus))
    {
        <div class="voice-call-status mt-2" role="status">
            <span class="text-muted">@_callStatus</span>
            @if (_outgoingCallConnectionId != null)
            {
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Enabled="@(!_busy)" OnClick="StopRinging">
                    Stop ringing
                </HxButton>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="text-danger mt-2" role="alert">@_error</div>
    }
    @if (_unreadableHttpsPeers.Count > 0)
    {
        <div class="text-danger mt-2" role="alert">Unreadable Stealth audio - different password or invalid encrypted frames:
            @string.Join(", ", State.OnlineUsers.Where(user => _unreadableHttpsPeers.Contains(user.ConnectionId)).Select(user => user.Name))
        </div>
    }

    @if (DebugMode && _showDebug)
    {
        <div class="voice-debug mt-3">
            <div class="voice-debug-header">
                <strong>@(_useHttpsAudio || (!_joined && _lastHttpsDiagnostics != null) ? "HTTPS audio diagnostics" : "ICE connection details")</strong>
                <div>
                    @if (_joined && _useHttpsAudio)
                    {
                        <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="ResumeHttpsAudio">
                            Resume audio
                        </HxButton>
                    }
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="RefreshDebug">
                        Refresh
                    </HxButton>
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="HideDebug">
                        Hide
                    </HxButton>
                </div>
            </div>
            <div class="voice-live-status mt-2" aria-live="off">
                <span>Call @FormatCallDuration(_callDuration)</span>
                <span>Up @_sendMbps.ToString("0.000") Mbps</span>
                <span>Down @_receiveMbps.ToString("0.000") Mbps</span>
            </div>
            <pre class="mt-2 mb-0">@_debugInfo</pre>
        </div>
    }

    @if (_transcriptionEnabled || _transcript.Count > 0 || !string.IsNullOrWhiteSpace(_transcriptionStatus))
    {
        <section class="voice-transcript mt-3" aria-label="Live call transcript">
            <div class="voice-transcript-header">
                <strong>Live transcript</strong>
                @if (_transcript.Count > 0)
                {
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="ClearTranscript">
                        Clear
                    </HxButton>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_transcriptionStatus))
            {
                <div class="text-muted" role="status">@_transcriptionStatus</div>
            }
            <div class="voice-transcript-content" aria-live="polite">
                @foreach (var text in _transcript)
                {
                    <p>@text</p>
                }
            </div>
        </section>
    }

    <div class="voice-video-grid mt-3">
        <figure class="voice-video-tile" @ref="_localVideoTile" hidden="@(!_videoEnabled)">
            <button type="button" class="voice-video-focus" title="Focus video" aria-label="Focus your video" aria-pressed="false" @onclick="ToggleLocalVideoFocus">
                <span aria-hidden="true">&#x26F6;</span>
            </button>
            <video @ref="_localVideo" class="@($"voice-video{(_screenSharing ? string.Empty : " voice-video-local")}")" autoplay muted playsinline aria-label="@(_screenSharing ? "Your shared screen preview" : "Your camera preview")"></video>
            <figcaption>@(_screenSharing ? "Shared screen" : LocalDisplayName) <span>(You)</span></figcaption>
        </figure>
        <div class="voice-remote-media" @ref="_remoteMediaContainer"></div>
    </div>

    <audio @ref="_ringtone" loop preload="auto" style="display: none">
        <source src="call.mp3" type="audio/mpeg" />
    </audio>
</section>

@code {
    [Parameter] public bool AdvancedMode { get; set; }

    [Parameter] public bool DebugMode { get; set; }

    private static readonly string CallAssetsPath = "./js/call/" +
        typeof(VoiceChannel).Assembly.GetCustomAttributes<System.Reflection.AssemblyMetadataAttribute>()
            .Single(attribute => attribute.Key == "CallAssetVersion").Value + "/";
    private static readonly string VoiceModulePath = CallAssetsPath + "voice-chat.js";

    private static readonly TimeSpan RingTimeout = TimeSpan.FromSeconds(30);
    private readonly HashSet<string> _participantIds = [];
    private readonly List<string> _transcript = [];
    private DotNetObjectReference<VoiceChannel>? _reference;
    private IJSObjectReference? _module;
    private IJSObjectReference? _httpsAudioModule;
    private bool _useHttpsAudio;
    private bool _forceStealth;
    private bool _opusAudio;
    private bool _joiningAutomatic;
    private bool _transitioning;
    private bool _fallbackPending;
    private long _voiceRevision;
    private long _mediaRevision;
    private string? _transportReason;
    private VoiceCapabilities? _voiceCapabilities;
    private VoiceCallState? _pendingVoiceState;
    private readonly SemaphoreSlim _voiceTransition = new(1, 1);
    private bool _webRtcReady;
    private readonly Queue<(string Kind, string Sender, string Payload)> _pendingWebRtcSignals = [];
    private readonly HashSet<string> _unreadableHttpsPeers = [];
    private IJSObjectReference? ActiveAudioModule => _useHttpsAudio ? _httpsAudioModule : _module;
    private IJSObjectReference? _turnDiagnosticsModule;
    private Task<IJSObjectReference>? _ringtoneModuleTask;
    private long _ringtoneRequestId;
    private ElementReference _remoteMediaContainer;
    private ElementReference _localVideo;
    private ElementReference _localVideoTile;
    private ElementReference _ringtone;
    private bool _joined;
    private bool _muted;
    private bool _videoEnabled;
    private bool _screenSharing;
    private bool _cameraEnabledBeforeScreenShare;
    private bool _busy;
    private bool _checkingTurn;
    private bool _checkingBrowserTurn;
    private bool _disposed;
    private bool _showDebug;
    private long _debugRequestVersion;
    private bool _audioOutputSelectionSupported;
    private bool _usesAudioSessionOutputModes;
    private bool _screenWakeLockSupported;
    private bool _keepScreenOn;
    private bool _screenSharingSupported;
    private bool _liveTranscriptionSupported;
    private bool _transcriptionEnabled;
    private string? _error;
    private string? _debugInfo;
    private string? _lastHttpsDiagnostics;
    private bool _debugModeEnabled;
    private string? _transcriptionStatus;
    private string? _incomingCallerConnectionId;
    private string? _incomingCallerName;
    private string? _outgoingCallConnectionId;
    private string? _outgoingCallName;
    private CancellationTokenSource? _outgoingCallTimeoutCancellation;
    private CancellationTokenSource? _callTimerCancellation;
    private System.Diagnostics.Stopwatch? _callStopwatch;
    private TimeSpan _callDuration;
    private double _sendMbps;
    private double _receiveMbps;
    private string? _callStatus;
    private string _audioQuality = "auto";
    private string _effectiveAudioQuality = "standard";
    private string _videoQuality = "auto";
    private string _effectiveVideoQuality = "standard";
    private Task? _qualityDefaultsTask;
    private bool _audioQualitySelected;
    private bool _videoQualitySelected;
    private string _audioOutputMode = "auto";
    private string _transcriptionModel = "auto";
    private string _recommendedTranscriptionModel = "tiny";
    private TurnHealthStatus? _turnHealth;
    private string? _turnHealthError;
    private TurnConnectionTestResult? _browserTurnResult;
    private string? _browserTurnError;
    private string _connectionHealth = "waiting";
    private string _connectionHealthDetail = "Waiting for another participant";

    private string SignalHealthCssClass => _connectionHealth switch
    {
        "healthy" => "voice-signal-healthy",
        "fair" => "voice-signal-fair",
        "poor" => "voice-signal-poor",
        _ => "voice-signal-checking"
    };

    private string SignalHealthLabel => $"Call connection: {_connectionHealth}. {_connectionHealthDetail}";

    private IEnumerable<OnlineUser> OtherOnlineUsers => State.OnlineUsers
        .Where(user => user.ConnectionId != SignalRStateManager.ConnectionId);

    private string LocalDisplayName => State.OnlineUsers
        .FirstOrDefault(user => user.ConnectionId == SignalRStateManager.ConnectionId)?.Name
        ?? State.UserInfo?.Name ?? "You";

    private ThemeColor TurnHealthColor => _turnHealthError != null ? ThemeColor.Danger : _turnHealth switch
    {
        { Healthy: true } => ThemeColor.Success,
        { Healthy: false } => ThemeColor.Danger,
        _ => ThemeColor.Secondary
    };

    private string BrowserTurnStatus => _checkingBrowserTurn
        ? "Testing from this browser..."
        : _browserTurnError != null ? "Browser relay test failed"
        : _browserTurnResult switch
        {
            { Succeeded: true, Tls: true } => "Last test: TURN TLS verified",
            { Succeeded: true, Tls: false } => "Last test: TURN reachable (no TLS)",
            { Succeeded: false, Tls: true } => "Last test: TURN TLS failed",
            { Succeeded: false } => "Last test: TURN failed",
            _ => "Browser relay: not tested"
        };

    private string BrowserTurnStatusCssClass => _checkingBrowserTurn ? "text-muted"
        : _browserTurnError != null ? "text-danger"
        : _browserTurnResult switch
        {
            { Succeeded: true, Tls: true } => "text-success",
            { Succeeded: true } => "text-warning",
            { Succeeded: false } => "text-danger",
            _ => "text-muted"
        };

    private string TurnHealthButtonText => _checkingTurn
        ? "Checking server relay..."
        : _turnHealthError != null ? "Server relay check failed" : _turnHealth switch
        {
            { Healthy: true, TurnTlsHealthy: true } => "Server TURN TLS verified",
            { Healthy: true } => "Server STUN/TURN healthy",
            { Healthy: false } => "Server relay check failed",
            _ => "Check server relay"
        };

    private string TurnHealthMessageCssClass => _turnHealth?.Healthy == true
        ? "voice-health-message mt-2 text-success"
        : "voice-health-message mt-2 text-danger";

    protected override void OnParametersSet()
    {
        if (DebugMode && !_debugModeEnabled)
        {
            _showDebug = true;
            _debugInfo = _lastHttpsDiagnostics;
        }
        if (!DebugMode && _showDebug)
        {
            HideDebug();
        }
        _debugModeEnabled = DebugMode;
    }

    protected override void OnInitialized()
    {
        SignalRStateManager.VoiceOfferReceived += ReceiveVoiceOffer;
        SignalRStateManager.VoiceAnswerReceived += ReceiveVoiceAnswer;
        SignalRStateManager.VoiceIceCandidateReceived += ReceiveVoiceIceCandidate;
        SignalRStateManager.VoiceParticipantLeftReceived += VoiceParticipantLeft;
        SignalRStateManager.VoiceCallReceivedEvent += VoiceCallReceived;
        SignalRStateManager.VoiceCallCancelledEvent += VoiceCallCancelled;
        SignalRStateManager.VoiceCallRespondedEvent += VoiceCallResponded;
        SignalRStateManager.ConnectionReconnected += ConnectionReconnected;
        SignalRStateManager.PresenceChanged += PresenceChanged;
        SignalRStateManager.HttpsAudioParticipantsChangedEvent += HttpsAudioParticipantsChanged;
        SignalRStateManager.HttpsAudioReceived += ReceiveHttpsAudio;
        SignalRStateManager.HttpsAudioFailedEvent += HttpsAudioFailed;
        SignalRStateManager.VoiceCallChangedEvent += VoiceCallChanged;
        SignalRStateManager.AutomaticAudioReceived += ReceiveAutomaticAudio;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await EnsureQualityDefaults();
        }
        catch (JSException exception)
        {
            _error = $"Unable to detect default media quality: {exception.Message}";
        }
        StateHasChanged();
    }

    private Task EnsureQualityDefaults() => _qualityDefaultsTask ??= ApplyQualityDefaults();

    private async Task ApplyQualityDefaults()
    {
        await using var defaults = await Js.InvokeAsync<IJSObjectReference>("import", "./js/media-defaults.js");
        var quality = await defaults.InvokeAsync<string>("getDefaultMediaQuality");
        if (!_audioQualitySelected)
        {
            _audioQuality = quality;
            _effectiveAudioQuality = quality == "auto" ? "standard" : quality;
        }
        if (!_videoQualitySelected)
        {
            _videoQuality = quality;
            _effectiveVideoQuality = quality == "auto" ? "standard" : quality;
        }
    }

    private Task PresenceChanged()
    {
        return InvokeAsync(async () =>
        {
            if (_joined && !_useHttpsAudio && _module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("updateParticipantNames", State.OnlineUsers);
                }
                catch (JSException exception)
                {
                    _error = $"Unable to update call participant names: {exception.Message}";
                }
            }
            StateHasChanged();
        });
    }

    private Task ConnectionReconnected()
    {
        return InvokeAsync(async () =>
        {
            if (!_joined) return;

            await CleanupBrowserVoice(preserveCallDuration: true);
            await Join();
            StateHasChanged();
        });
    }

    private async Task Join()
    {
        _busy = true;
        _joiningAutomatic = true;
        _error = null;
        _lastHttpsDiagnostics = null;
        _showDebug = DebugMode;

        try
        {
            await EnsureQualityDefaults();
            _reference ??= DotNetObjectReference.Create(this);

            _httpsAudioModule ??= await Js.InvokeAsync<IJSObjectReference>("import", CallAssetsPath + "https-audio.js");
            _voiceCapabilities = await _httpsAudioModule.InvokeAsync<VoiceCapabilities>("getCapabilities");
            _voiceCapabilities.ForceStealth = _forceStealth;
            var state = await SignalRStateManager.JoinAutomaticVoice(_voiceCapabilities);
            if (_disposed) { await SignalRStateManager.LeaveVoice(); return; }
            _joined = true;
            StartCallTimer();
            QueueVoiceState(state);
            await ApplyQueuedVoiceStates();
        }
        catch (Exception exception)
        {
            _error = $"Unable to join voice: {exception.Message}";
            Logger.LogWarning(exception, "Unable to join automatic voice");
            try
            {
                if (_joined) await SignalRStateManager.LeaveVoice();
            }
            finally { await CleanupBrowserVoice(); }
        }
        finally
        {
            _joiningAutomatic = false;
            _busy = false;
        }
    }

    private async Task<IJSObjectReference> InitializeWebRtc(string voiceKey)
    {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", VoiceModulePath);
            var turnCredentials = await SignalRStateManager.GetTurnCredentials();
            await _module.InvokeVoidAsync(
                "initialize",
                _reference,
                _remoteMediaContainer,
                _localVideo,
                turnCredentials,
                voiceKey,
                _audioQuality,
                _videoQuality,
                true);
            _audioOutputSelectionSupported = await _module.InvokeAsync<bool>("supportsAudioOutputSelection");
            _usesAudioSessionOutputModes = await _module.InvokeAsync<bool>("usesAudioSessionOutputModes");
            _screenWakeLockSupported = await _module.InvokeAsync<bool>("supportsMobileScreenWakeLock");
            if (_keepScreenOn && _screenWakeLockSupported)
            {
                _keepScreenOn = await _module.InvokeAsync<bool>("setKeepScreenOn", true);
            }
            try
            {
                _screenSharingSupported = await _module.InvokeAsync<bool>("supportsScreenSharing");
            }
            catch (JSException)
            {
                _screenSharingSupported = false;
            }
            try
            {
                _liveTranscriptionSupported = await _module.InvokeAsync<bool>("supportsLiveTranscription");
                if (_liveTranscriptionSupported)
                {
                    _recommendedTranscriptionModel = await _module.InvokeAsync<string>("getRecommendedTranscriptionModel");
                }
            }
            catch (JSException exception) when (exception.Message.Contains("supportsLiveTranscription"))
            {
                _liveTranscriptionSupported = false;
            }
            return _module;
    }

    private void QueueVoiceState(VoiceCallState state)
    {
        if (state.Revision > _voiceRevision && (_pendingVoiceState == null || state.Revision > _pendingVoiceState.Revision))
            _pendingVoiceState = state;
    }

    private async Task ApplyQueuedVoiceStates()
    {
        while (_pendingVoiceState is { } state && _joined && !_disposed)
        {
            _pendingVoiceState = null;
            await ApplyVoiceState(state);
        }
    }

    private async Task ApplyVoiceState(VoiceCallState state)
    {
        await _voiceTransition.WaitAsync();
        var wasBusy = _busy;
        try
        {
            if (!_joined || _disposed || state.Revision <= _voiceRevision) return;
            _voiceRevision = state.Revision;
            _participantIds.Clear();
            _participantIds.UnionWith(state.Participants.Select(peer => peer.ConnectionId));
            _unreadableHttpsPeers.IntersectWith(_participantIds);
            _transportReason = state.Reason;
            if (_mediaRevision == state.MediaRevision)
            {
                if (_useHttpsAudio && _httpsAudioModule != null)
                    await _httpsAudioModule.InvokeVoidAsync("setParticipants", state.Participants);
                return;
            }
            _transitioning = true;
            _busy = true;
            _webRtcReady = false;
            if (_module != null) await _module.InvokeVoidAsync("leave");
            if (_httpsAudioModule != null) await _httpsAudioModule.InvokeVoidAsync("leave");
            _useHttpsAudio = state.HttpsAudio;
            _opusAudio = state.Opus;
            _mediaRevision = state.MediaRevision;
            _unreadableHttpsPeers.Clear();
            _videoEnabled = _screenSharing = _transcriptionEnabled = false;
            _screenSharingSupported = _liveTranscriptionSupported = false;
            _audioOutputSelectionSupported = _usesAudioSessionOutputModes = _screenWakeLockSupported = false;
            _connectionHealth = "waiting";
            _connectionHealthDetail = "Negotiating encrypted call transport";
            _debugInfo = null;
            _sendMbps = _receiveMbps = 0;
            var user = State.UserInfo ?? throw new InvalidOperationException("Chat session is not available");
            var key = Convert.ToBase64String(HashingUtility.DeriveVoiceKey(user.Password, user.Channel));
            if (_useHttpsAudio)
            {
                _pendingWebRtcSignals.Clear();
                var module = _httpsAudioModule ?? throw new InvalidOperationException("HTTPS audio module is unavailable");
                await module.InvokeVoidAsync("initialize", _reference, key, _opusAudio, _muted, _mediaRevision);
                if (!_joined || _disposed) { await module.InvokeVoidAsync("leave"); return; }
                await module.InvokeVoidAsync("setParticipants", state.Participants);
            }
            else
            {
                IJSObjectReference module;
                try
                {
                    module = await InitializeWebRtc(key);
                }
                catch (HubException exception) when (_voiceCapabilities?.SupportsHttpsAudio == true)
                {
                    Logger.LogWarning(exception, "WebRTC relay configuration unavailable; negotiating HTTPS audio");
                    QueueVoiceState(await SignalRStateManager.RequestHttpsAudio(_mediaRevision));
                    return;
                }
                if (!_joined || _disposed) { await module.InvokeVoidAsync("leave"); return; }
                await module.InvokeVoidAsync("setMuted", _muted);
                _webRtcReady = true;
                while (_pendingWebRtcSignals.TryDequeue(out var signal) && _joined && !_useHttpsAudio)
                {
                    if (signal.Kind == "offer") await ReceiveVoiceOffer(signal.Sender, signal.Payload);
                    else if (signal.Kind == "answer") await ReceiveVoiceAnswer(signal.Sender, signal.Payload);
                    else await ReceiveVoiceIceCandidate(signal.Sender, signal.Payload);
                }
                await module.InvokeVoidAsync("connectToParticipants", state.Participants);
            }
        }
        finally
        {
            _transitioning = false;
            _busy = wasBusy;
            _voiceTransition.Release();
            StateHasChanged();
        }
    }

    private Task VoiceCallChanged(VoiceCallState state) => InvokeAsync(async () =>
    {
        if (_disposed || (!_joined && !_joiningAutomatic)) return;
        QueueVoiceState(state);
        if (_joiningAutomatic) return;
        try { await ApplyQueuedVoiceStates(); }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to apply negotiated voice transport");
            await HttpsAudioFailed($"Unable to switch call transport: {exception.Message}");
        }
    });

    [JSInvokable]
    public Task WebRtcMediaFailed(string reason) => InvokeAsync(async () =>
    {
        if (!_joined || _useHttpsAudio || _fallbackPending || _disposed) return;
        _fallbackPending = true;
        try
        {
            Logger.LogInformation("Negotiating HTTPS audio: {Reason}", reason);
            QueueVoiceState(await SignalRStateManager.RequestHttpsAudio(_mediaRevision));
            await ApplyQueuedVoiceStates();
        }
        catch (Exception exception)
        {
            _error = $"Unable to negotiate Stealth audio: {exception.Message}";
            Logger.LogWarning(exception, "Automatic audio fallback failed");
        }
        finally { _fallbackPending = false; StateHasChanged(); }
    });

