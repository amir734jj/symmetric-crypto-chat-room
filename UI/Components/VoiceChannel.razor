    public Task TranscriptionTextReceived(string text)
    {
        return InvokeAsync(() =>
        {
            if (!_transcriptionEnabled || string.IsNullOrWhiteSpace(text)) return;

            _transcript.Add(text.Trim());
            while (_transcript.Count > 100)
            {
                _transcript.RemoveAt(0);
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task TranscriptionStatusChanged(string status, bool failed)
    {
        return InvokeAsync(() =>
        {
            _transcriptionStatus = status;
            if (failed)
            {
                _transcriptionEnabled = false;
                _error = status;
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task TranscriptionStopped(string status)
    {
        return InvokeAsync(() =>
        {
            _transcriptionEnabled = false;
            _transcriptionStatus = status;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task VideoQualityAdapted(string quality)
    {
        return InvokeAsync(() =>
        {
            _effectiveVideoQuality = quality;
            StateHasChanged();
        });
    }

    private static string AudioQualityLabel(string quality)
    {
        return quality switch
        {
            "very-low" => "Very low",
            "low" => "Low",
            "high" => "High",
            _ => "Medium"
        };
    }

    private static string VideoQualityLabel(string quality)
    {
        return quality switch
        {
            "very-low" => "Very low (144p)",
            "low" => "Low (240p)",
            "high" => "High (720p)",
            _ => "Medium (480p)"
        };
    }

    private static string TranscriptionModelLabel(string model)
    {
        return model switch
        {
            "small" => "Whisper Small",
            "base" => "Whisper Base",
            _ => "Whisper Tiny"
        };
    }

    private void StartCallTimer()
    {
        if (_callStopwatch?.IsRunning == true) return;

        StopCallTimer();
        _callStopwatch = System.Diagnostics.Stopwatch.StartNew();
        _callTimerCancellation = new CancellationTokenSource();
        _ = UpdateCallDuration(_callTimerCancellation.Token);
    }

    private async Task UpdateCallDuration(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                double[]? dataRates = null;
                string? debugInfo = null;
                var debugVersion = _debugRequestVersion;
                var module = ActiveAudioModule;
                if (_joined && _showDebug && module != null)
                {
                    try
                    {
                        dataRates = await module.InvokeAsync<double[]?>(
                            "getLiveDataRateMbps",
                            cancellationToken);
                        debugInfo = await module.InvokeAsync<string>(
                            "getConnectionDiagnostics", cancellationToken);
                    }
                    catch when (cancellationToken.IsCancellationRequested || !_joined)
                    {
                    }
                    catch (Exception exception)
                    {
                        Logger.LogWarning(exception, "Unable to refresh call diagnostics");
                        debugInfo = $"Unable to refresh call diagnostics: {exception.Message}";
                        dataRates = null;
                    }
                }

                await InvokeAsync(() =>
                {
                    _callDuration = _callStopwatch?.Elapsed ?? TimeSpan.Zero;
                    if (_joined && _showDebug && debugVersion == _debugRequestVersion)
                        _debugInfo = debugInfo;
                    if (dataRates is { Length: >= 2 })
                    {
                        _sendMbps = dataRates[0];
                        _receiveMbps = dataRates[1];
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void StopCallTimer()
    {
        _callTimerCancellation?.Cancel();
        _callTimerCancellation?.Dispose();
        _callTimerCancellation = null;
        _callStopwatch?.Stop();
        _callStopwatch = null;
        _callDuration = TimeSpan.Zero;
        _sendMbps = 0;
        _receiveMbps = 0;
    }

    private static string FormatCallDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes:00}:{duration.Seconds:00}";
    }

    private async Task CleanupBrowserVoice(bool preserveCallDuration = false)
    {
        _voiceRevision = 0;
        _mediaRevision = 0;
        _pendingVoiceState = null;
        _webRtcReady = false;
        _pendingWebRtcSignals.Clear();
        if (_httpsAudioModule != null)
        {
            await _httpsAudioModule.InvokeVoidAsync("leave");
            if (_useHttpsAudio)
            {
                try
                {
                    var diagnostics = await _httpsAudioModule.InvokeAsync<string>("getConnectionDiagnostics");
                    _lastHttpsDiagnostics = string.IsNullOrWhiteSpace(_error)
                        ? diagnostics : $"Last reported call error: {_error}\n\n{diagnostics}";
                }
                catch (JSException exception)
                {
                    Logger.LogWarning(exception, "Unable to preserve HTTPS audio diagnostics");
                    _lastHttpsDiagnostics = $"Unable to preserve HTTPS audio diagnostics: {exception.Message}";
                }
            }
        }
        if (_module != null)
        {
            await _module.InvokeVoidAsync("leave");
        }

        _participantIds.Clear();
        _unreadableHttpsPeers.Clear();
        _joined = false;
        _useHttpsAudio = false;
        _transportReason = null;
        _connectionHealth = "waiting";
        _connectionHealthDetail = "Waiting for another participant";
        _muted = false;
        _videoEnabled = false;
        _screenSharing = false;
        _cameraEnabledBeforeScreenShare = false;
        _showDebug = DebugMode && _lastHttpsDiagnostics != null;
        _audioOutputSelectionSupported = false;
        _usesAudioSessionOutputModes = false;
        _screenWakeLockSupported = false;
        if (!preserveCallDuration)
        {
            _keepScreenOn = false;
        }
        _screenSharingSupported = false;
        _liveTranscriptionSupported = false;
        _transcriptionEnabled = false;
        _transcriptionStatus = null;
        _transcript.Clear();
        _audioOutputMode = "auto";
        _debugInfo = _lastHttpsDiagnostics;
        if (!preserveCallDuration)
        {
            StopCallTimer();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_turnDiagnosticsModule != null)
        {
            await _turnDiagnosticsModule.InvokeVoidAsync("cancelTurnConnectionTest");
            await _turnDiagnosticsModule.DisposeAsync();
        }
        ClearOutgoingCall();
        SignalRStateManager.VoiceOfferReceived -= ReceiveVoiceOffer;
        SignalRStateManager.VoiceAnswerReceived -= ReceiveVoiceAnswer;
        SignalRStateManager.VoiceIceCandidateReceived -= ReceiveVoiceIceCandidate;
        SignalRStateManager.VoiceParticipantLeftReceived -= VoiceParticipantLeft;
        SignalRStateManager.VoiceCallReceivedEvent -= VoiceCallReceived;
        SignalRStateManager.VoiceCallCancelledEvent -= VoiceCallCancelled;
        SignalRStateManager.VoiceCallRespondedEvent -= VoiceCallResponded;
        SignalRStateManager.ConnectionReconnected -= ConnectionReconnected;
        SignalRStateManager.PresenceChanged -= PresenceChanged;
        SignalRStateManager.HttpsAudioParticipantsChangedEvent -= HttpsAudioParticipantsChanged;
        SignalRStateManager.HttpsAudioReceived -= ReceiveHttpsAudio;
        SignalRStateManager.HttpsAudioFailedEvent -= HttpsAudioFailed;
        SignalRStateManager.VoiceCallChangedEvent -= VoiceCallChanged;
        SignalRStateManager.AutomaticAudioReceived -= ReceiveAutomaticAudio;

        await StopRingtone();

        if (_ringtoneModuleTask != null)
        {
            var ringtoneModule = await _ringtoneModuleTask;
            await ringtoneModule.InvokeVoidAsync("dispose");
            await ringtoneModule.DisposeAsync();
        }

        try
        {
            if (_joined && State.UserInfo != null)
            {
                await SignalRStateManager.LeaveVoice();
            }
        }
        finally
        {
            await CleanupBrowserVoice();
            if (_module != null)
            {
                await _module.DisposeAsync();
            }
            if (_httpsAudioModule != null)
            {
                await _httpsAudioModule.DisposeAsync();
            }
            _reference?.Dispose();
        }
    }
}