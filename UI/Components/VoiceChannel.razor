@using Models
@inject SignalRStateManager SignalRStateManager
@inject State State
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="voice-channel mb-3" aria-label="Voice and video channel">
    <div class="voice-channel-header">
        <div class="voice-channel-title">
            <strong>Voice &amp; video</strong>
            @if (_joined)
            {
                <span class="ms-2 text-muted">@(_participantIds.Count + 1) connected</span>
            }
        </div>

        <div class="voice-channel-actions">
            <label class="voice-quality">
                <span>Audio quality</span>
                <select @key="_effectiveAudioQuality" class="form-select form-select-sm" @bind="_audioQuality" @bind:after="AudioQualityChanged" disabled="@_busy">
                    <option value="auto">Auto - Current: @AudioQualityLabel(_effectiveAudioQuality)</option>
                    <option value="low">Low</option>
                    <option value="standard">Medium</option>
                    <option value="high">High</option>
                </select>
            </label>
            <label class="voice-quality">
                <span>Camera quality</span>
                <select @key="_effectiveVideoQuality" class="form-select form-select-sm" @bind="_videoQuality" @bind:after="VideoQualityChanged" disabled="@_busy">
                    <option value="auto">Auto - Current: @VideoQualityLabel(_effectiveVideoQuality)</option>
                    <option value="low">Low (240p)</option>
                    <option value="standard">Medium (480p)</option>
                    <option value="high">High (720p)</option>
                </select>
            </label>
            <HxButton Color="@TurnHealthColor" Enabled="@(!_checkingTurn)" OnClick="CheckTurnHealth">
                @TurnHealthButtonText
            </HxButton>
            @if (!_joined)
            {
                <HxButton Color="ThemeColor.Success" Enabled="@(!_busy)" OnClick="Join">
                    Join bridge
                </HxButton>
            }
            else
            {
                @if (_usesAudioSessionOutputModes)
                {
                    <label class="voice-quality voice-transcription-model">
                        <span>Audio output</span>
                        <select class="form-select form-select-sm" @bind="_audioOutputMode" @bind:after="AudioOutputModeChanged">
                            <option value="auto">Auto (proximity)</option>
                            <option value="earpiece">Always earpiece</option>
                            <option value="speaker">Always speaker</option>
                        </select>
                    </label>
                }
                else if (_audioOutputSelectionSupported)
                {
                    <HxButton Color="ThemeColor.Secondary" OnClick="ChooseAudioOutput">
                        Choose output
                    </HxButton>
                }
                else
                {
                    <label class="voice-quality" title="This browser does not allow websites to change the phone audio route">
                        <span>Audio output</span>
                        <select class="form-select form-select-sm" disabled>
                            <option>Auto (browser controlled)</option>
                            <option>Always earpiece</option>
                            <option>Always speaker</option>
                        </select>
                    </label>
                    <span class="voice-output-note text-muted">Speaker and earpiece selection is unavailable in this browser.</span>
                }
                <HxButton Color="ThemeColor.Secondary" OnClick="ToggleMute">
                    @(_muted ? "Unmute" : "Mute")
                </HxButton>
                <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy && !_screenSharing)" OnClick="ToggleVideo">
                    @(_videoEnabled ? "Stop video" : "Start video")
                </HxButton>
                @if (_screenSharingSupported || _screenSharing)
                {
                    <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy)" OnClick="ToggleScreenSharing">
                        @(_screenSharing ? "Stop sharing" : "Share screen")
                    </HxButton>
                }
                @if (_liveTranscriptionSupported)
                {
                    <label class="voice-quality voice-transcription-model">
                        <span>Transcription model</span>
                        <select class="form-select form-select-sm" @bind="_transcriptionModel" disabled="@(_busy || _transcriptionEnabled)">
                            <option value="auto">Default (Auto) - Recommended: @TranscriptionModelLabel(_recommendedTranscriptionModel)</option>
                            <option value="tiny">Multilingual Tiny - Fastest, least accurate</option>
                            <option value="base">Multilingual Base - More accurate, slower</option>
                            <option value="small">Multilingual Small - Most accurate, slowest</option>
                            <option value="tiny-en">English Tiny - Fastest for English</option>
                            <option value="base-en">English Base - More accurate English, slower</option>
                            <option value="small-en">English Small - Most accurate English, slowest</option>
                        </select>
                    </label>
                    <HxButton Color="ThemeColor.Secondary" Enabled="@(!_busy && (_transcriptionEnabled || _participantIds.Count > 0))" OnClick="ToggleTranscription">
                        @(_transcriptionEnabled ? "Stop transcription" : "Start transcription")
                    </HxButton>
                }
                <HxButton Color="ThemeColor.Secondary" OnClick="ToggleDebug">
                    @(_showDebug ? "Hide ICE debug" : "ICE debug")
                </HxButton>
                <HxButton Color="ThemeColor.Danger" OnClick="Leave">
                    @(_participantIds.Count > 0 ? "End call" : "Leave call")
                </HxButton>
            }
        </div>
    </div>

    <div class="voice-presence mt-3">
        <strong>Online</strong>
        @if (!OtherOnlineUsers.Any())
        {
            <span class="text-muted">No one else is online</span>
        }
        else
        {
            @foreach (var user in OtherOnlineUsers)
            {
                <div class="voice-online-user">
                    <span>@user.Name</span>
                    @if (_participantIds.Contains(user.ConnectionId))
                    {
                        <span class="text-success">In call</span>
                    }
                    else
                    {
                        <HxButton Size="ButtonSize.Small" Color="ThemeColor.Primary" Enabled="@(!_busy && _outgoingCallConnectionId == null)" OnClick="@(() => Ring(user))">
                            Ring
                        </HxButton>
                    }
                </div>
            }
        }
    </div>

    @if (_incomingCallerConnectionId != null)
    {
        <div class="voice-call-alert mt-3" role="alert">
            <strong>@_incomingCallerName is calling</strong>
            <div>
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Success" Enabled="@(!_busy)" OnClick="AcceptCall">
                    Accept
                </HxButton>
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Danger" Enabled="@(!_busy)" OnClick="DeclineCall">
                    Decline
                </HxButton>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_callStatus))
    {
        <div class="voice-call-status mt-2" role="status">
            <span class="text-muted">@_callStatus</span>
            @if (_outgoingCallConnectionId != null)
            {
                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Enabled="@(!_busy)" OnClick="StopRinging">
                    Stop ringing
                </HxButton>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="text-danger mt-2" role="alert">@_error</div>
    }

    @if (_turnHealth != null)
    {
        <div class="@TurnHealthMessageCssClass" role="status">
            @_turnHealth.Host:@_turnHealth.Port - @_turnHealth.Message
        </div>
    }

    @if (_showDebug)
    {
        <div class="voice-debug mt-3">
            <div class="voice-debug-header">
                <strong>ICE connection details</strong>
                <div>
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="RefreshDebug">
                        Refresh
                    </HxButton>
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="HideDebug">
                        Hide
                    </HxButton>
                </div>
            </div>
            <div class="voice-live-status mt-2" aria-live="off">
                <span>Call @FormatCallDuration(_callDuration)</span>
                <span>Up @_sendMbps.ToString("0.000") Mbps</span>
                <span>Down @_receiveMbps.ToString("0.000") Mbps</span>
            </div>
            <pre class="mt-2 mb-0">@_debugInfo</pre>
        </div>
    }

    @if (_transcriptionEnabled || _transcript.Count > 0 || !string.IsNullOrWhiteSpace(_transcriptionStatus))
    {
        <section class="voice-transcript mt-3" aria-label="Live call transcript">
            <div class="voice-transcript-header">
                <strong>Live transcript</strong>
                @if (_transcript.Count > 0)
                {
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="ClearTranscript">
                        Clear
                    </HxButton>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_transcriptionStatus))
            {
                <div class="text-muted" role="status">@_transcriptionStatus</div>
            }
            <div class="voice-transcript-content" aria-live="polite">
                @foreach (var text in _transcript)
                {
                    <p>@text</p>
                }
            </div>
        </section>
    }

    <div class="voice-video-grid mt-3">
        <figure class="voice-video-tile" @ref="_localVideoTile" hidden="@(!_videoEnabled)">
            <button type="button" class="voice-video-focus" title="Focus video" aria-label="Focus your video" aria-pressed="false" @onclick="ToggleLocalVideoFocus">
                <span aria-hidden="true">&#x26F6;</span>
            </button>
            <video @ref="_localVideo" class="voice-video voice-video-local" autoplay muted playsinline aria-label="@(_screenSharing ? "Your shared screen preview" : "Your camera preview")"></video>
            <figcaption>@(_screenSharing ? "Shared screen" : State.UserInfo?.Name ?? "You") <span>(You)</span></figcaption>
        </figure>
        <div class="voice-remote-media" @ref="_remoteMediaContainer"></div>
    </div>

    <audio @ref="_ringtone" loop preload="auto" style="display: none">
        <source src="call.mp3" type="audio/mpeg" />
    </audio>
</section>

@code {
    private const string VoiceModulePath = "./js/voice-chat.js?v=20260906-7";

    private static readonly TimeSpan RingTimeout = TimeSpan.FromSeconds(30);
    private readonly HashSet<string> _participantIds = [];
    private readonly List<string> _transcript = [];
    private DotNetObjectReference<VoiceChannel>? _reference;
    private IJSObjectReference? _module;
    private ElementReference _remoteMediaContainer;
    private ElementReference _localVideo;
    private ElementReference _localVideoTile;
    private ElementReference _ringtone;
    private bool _joined;
    private bool _muted;
    private bool _videoEnabled;
    private bool _screenSharing;
    private bool _cameraEnabledBeforeScreenShare;
    private bool _busy;
    private bool _checkingTurn;
    private bool _showDebug;
    private long _debugRequestVersion;
    private bool _audioOutputSelectionSupported;
    private bool _usesAudioSessionOutputModes;
    private bool _screenSharingSupported;
    private bool _liveTranscriptionSupported;
    private bool _transcriptionEnabled;
    private string? _error;
    private string? _debugInfo;
    private string? _transcriptionStatus;
    private string? _incomingCallerConnectionId;
    private string? _incomingCallerName;
    private string? _outgoingCallConnectionId;
    private string? _outgoingCallName;
    private CancellationTokenSource? _outgoingCallTimeoutCancellation;
    private CancellationTokenSource? _callTimerCancellation;
    private System.Diagnostics.Stopwatch? _callStopwatch;
    private TimeSpan _callDuration;
    private double _sendMbps;
    private double _receiveMbps;
    private string? _callStatus;
    private string _audioQuality = "auto";
    private string _effectiveAudioQuality = "standard";
    private string _videoQuality = "auto";
    private string _effectiveVideoQuality = "standard";
    private string _audioOutputMode = "auto";
    private string _transcriptionModel = "auto";
    private string _recommendedTranscriptionModel = "tiny";
    private TurnHealthStatus? _turnHealth;

    private IEnumerable<OnlineUser> OtherOnlineUsers => State.OnlineUsers
        .Where(user => user.ConnectionId != SignalRStateManager.ConnectionId)
        .Where(user => !string.Equals(user.Name, State.UserInfo?.Name, StringComparison.OrdinalIgnoreCase));

    private ThemeColor TurnHealthColor => _turnHealth switch
    {
        { Healthy: true } => ThemeColor.Success,
        { Healthy: false } => ThemeColor.Danger,
        _ => ThemeColor.Secondary
    };

    private string TurnHealthButtonText => _checkingTurn
        ? "Checking STUN/TURN..."
        : _turnHealth switch
        {
            { Healthy: true } => "STUN/TURN healthy",
            { Healthy: false } => "STUN/TURN unavailable",
            _ => "Check STUN/TURN"
        };

    private string TurnHealthMessageCssClass => _turnHealth?.Healthy == true
        ? "voice-health-message mt-2 text-success"
        : "voice-health-message mt-2 text-danger";

    protected override void OnInitialized()
    {
        SignalRStateManager.VoiceOfferReceived += ReceiveVoiceOffer;
        SignalRStateManager.VoiceAnswerReceived += ReceiveVoiceAnswer;
        SignalRStateManager.VoiceIceCandidateReceived += ReceiveVoiceIceCandidate;
        SignalRStateManager.VoiceParticipantLeftReceived += VoiceParticipantLeft;
        SignalRStateManager.VoiceCallReceivedEvent += VoiceCallReceived;
        SignalRStateManager.VoiceCallCancelledEvent += VoiceCallCancelled;
        SignalRStateManager.VoiceCallRespondedEvent += VoiceCallResponded;
        SignalRStateManager.ConnectionReconnected += ConnectionReconnected;
        SignalRStateManager.PresenceChanged += PresenceChanged;
    }

    private Task PresenceChanged()
    {
        return InvokeAsync(StateHasChanged);
    }

    private Task ConnectionReconnected()
    {
        return InvokeAsync(async () =>
        {
            if (!_joined) return;

            await CleanupBrowserVoice(preserveCallDuration: true);
            await Join();
            StateHasChanged();
        });
    }

    private async Task Join()
    {
        _busy = true;
        _error = null;

        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", VoiceModulePath);
            _reference ??= DotNetObjectReference.Create(this);

            var turnCredentials = await SignalRStateManager.GetTurnCredentials();
            var userInfo = State.UserInfo ?? throw new InvalidOperationException("Chat session is not available");
            var voiceKey = Convert.ToBase64String(HashingUtility.DeriveVoiceKey(userInfo.Password, userInfo.Channel));
            await _module.InvokeVoidAsync(
                "initialize",
                _reference,
                _remoteMediaContainer,
                _localVideo,
                turnCredentials,
                voiceKey,
                _audioQuality,
                _videoQuality);
            _audioOutputSelectionSupported = await _module.InvokeAsync<bool>("supportsAudioOutputSelection");
            _usesAudioSessionOutputModes = await _module.InvokeAsync<bool>("usesAudioSessionOutputModes");
            try
            {
                _screenSharingSupported = await _module.InvokeAsync<bool>("supportsScreenSharing");
            }
            catch (JSException)
            {
                _screenSharingSupported = false;
            }
            try
            {
                _liveTranscriptionSupported = await _module.InvokeAsync<bool>("supportsLiveTranscription");
                if (_liveTranscriptionSupported)
                {
                    _recommendedTranscriptionModel = await _module.InvokeAsync<string>("getRecommendedTranscriptionModel");
                }
            }
            catch (JSException exception) when (exception.Message.Contains("supportsLiveTranscription"))
            {
                _liveTranscriptionSupported = false;
            }

            var participants = await SignalRStateManager.JoinVoice();
            _joined = true;
            StartCallTimer();
            _participantIds.UnionWith(participants.Select(participant => participant.ConnectionId));
            await _module.InvokeVoidAsync(
                "connectToParticipants",
                (object)participants.Select(participant => new
                {
                    participant.ConnectionId,
                    participant.Name
                }).ToArray());
        }
        catch (Exception exception)
        {
            _error = $"Unable to join voice: {exception.Message}";
            if (_joined)
            {
                await SignalRStateManager.LeaveVoice();
            }
            await CleanupBrowserVoice();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMute()
    {
        _muted = !_muted;
        await _module!.InvokeVoidAsync("setMuted", _muted);
    }

    private async Task ToggleVideo()
    {
        if (_module == null) return;

        _busy = true;
        try
        {
            _videoEnabled = await _module.InvokeAsync<bool>("setVideoEnabled", !_videoEnabled);
            _error = null;
        }
        catch (Exception exception)
        {
            _error = $"Unable to change camera state: {exception.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleLocalVideoFocus()
    {
        if (_module == null) return;

        await _module.InvokeVoidAsync("toggleVideoFocus", _localVideoTile);
    }

    private async Task ToggleScreenSharing()
    {
        if (_module == null || (!_screenSharingSupported && !_screenSharing)) return;

        _busy = true;
        try
        {
            if (!_screenSharing)
            {
                _cameraEnabledBeforeScreenShare = _videoEnabled;
                _screenSharing = await _module.InvokeAsync<bool>("setScreenSharing", true);
                _videoEnabled = _screenSharing || _videoEnabled;
            }
            else
            {
                _screenSharing = await _module.InvokeAsync<bool>("setScreenSharing", false);
                _videoEnabled = _cameraEnabledBeforeScreenShare;
                _cameraEnabledBeforeScreenShare = false;
            }
            _error = null;
        }
        catch (Exception exception)
        {
            _error = $"Unable to change screen sharing: {exception.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleTranscription()
    {
        if (_module == null) return;
        if (!_transcriptionEnabled && _participantIds.Count == 0)
        {
            _transcriptionStatus = "Connect to another participant to start transcription.";
            return;
        }

        _busy = true;
        try
        {
            _transcriptionEnabled = await _module.InvokeAsync<bool>(
                "setTranscriptionEnabled",
                !_transcriptionEnabled,
                _transcriptionModel);
            _transcriptionStatus = _transcriptionEnabled
                ? "Preparing on-device transcription model..."
                : null;
            _error = null;
        }
        catch (Exception exception)
        {
            _transcriptionEnabled = false;
            _transcriptionStatus = null;
            _error = $"Unable to change live transcription: {exception.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearTranscript()
    {
        _transcript.Clear();
    }

    private async Task ChooseAudioOutput()
    {
        if (_module == null) return;

        try
        {
            var outputLabel = await _module.InvokeAsync<string>("chooseAudioOutput");
            _callStatus = $"Audio output: {outputLabel}";
            _error = null;
        }
        catch (Exception exception)
        {
            _error = $"Unable to change audio output: {exception.Message}";
        }
    }

    private async Task AudioOutputModeChanged()
    {
        if (_module == null) return;

        try
        {
            _audioOutputMode = await _module.InvokeAsync<string>("setAudioOutputMode", _audioOutputMode);
            _callStatus = _audioOutputMode switch
            {
                "speaker" => "Audio output: Speaker",
                "earpiece" => "Audio output: Earpiece",
                _ => "Audio output: Auto (proximity when available)"
            };
            _error = null;
        }
        catch (Exception exception)
        {
            _error = $"Unable to change audio output: {exception.Message}";
        }
    }

    private async Task AudioQualityChanged()
    {
        if (_joined && _module != null)
        {
            try
            {
                _effectiveAudioQuality = await _module.InvokeAsync<string>("setAudioQuality", _audioQuality);
                _error = null;
            }
            catch (Exception exception)
            {
                _error = $"Unable to change audio quality: {exception.Message}";
            }
        }
    }

    private async Task VideoQualityChanged()
    {
        if (_joined && _module != null)
        {
            try
            {
                _effectiveVideoQuality = await _module.InvokeAsync<string>("setVideoQuality", _videoQuality);
                _error = null;
            }
            catch (Exception exception)
            {
                _error = $"Unable to change camera quality: {exception.Message}";
            }
        }
    }

    private async Task Ring(OnlineUser user)
    {
        _callStatus = null;
        if (!_joined)
        {
            await Join();
        }

        if (!_joined) return;

        try
        {
            await SignalRStateManager.RingVoice(user.ConnectionId);
            _outgoingCallConnectionId = user.ConnectionId;
            _outgoingCallName = user.Name;
            _callStatus = $"Ringing {user.Name}... (30 seconds)";
            StartOutgoingCallTimeout(user.ConnectionId, user.Name);
        }
        catch (Exception exception)
        {
            _error = $"Unable to ring {user.Name}: {exception.Message}";
        }
    }

    private async Task StopRinging()
    {
        var targetConnectionId = _outgoingCallConnectionId;
        var targetName = _outgoingCallName;
        if (targetConnectionId == null) return;

        try
        {
            await SignalRStateManager.CancelVoiceCall(targetConnectionId);
        }
        catch
        {
        }
        finally
        {
            ClearOutgoingCall();
        }

        _callStatus = targetName == null ? "Call cancelled" : $"Stopped ringing {targetName}";
    }

    private void StartOutgoingCallTimeout(string targetConnectionId, string targetName)
    {
        _outgoingCallTimeoutCancellation?.Cancel();
        _outgoingCallTimeoutCancellation?.Dispose();
        _outgoingCallTimeoutCancellation = new CancellationTokenSource();
        _ = StopRingingAfterTimeout(targetConnectionId, targetName, _outgoingCallTimeoutCancellation.Token);
    }

    private async Task StopRingingAfterTimeout(
        string targetConnectionId,
        string targetName,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(RingTimeout, cancellationToken);
            await InvokeAsync(async () =>
            {
                if (_outgoingCallConnectionId != targetConnectionId) return;

                await SignalRStateManager.CancelVoiceCall(targetConnectionId, true);
                ClearOutgoingCall();
                _callStatus = $"{targetName} did not answer";
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch
        {
            await InvokeAsync(() =>
            {
                ClearOutgoingCall();
                _callStatus = $"{targetName} did not answer";
                StateHasChanged();
            });
        }
    }

    private void ClearOutgoingCall()
    {
        _outgoingCallTimeoutCancellation?.Cancel();
        _outgoingCallTimeoutCancellation?.Dispose();
        _outgoingCallTimeoutCancellation = null;
        _outgoingCallConnectionId = null;
        _outgoingCallName = null;
    }

    private Task VoiceCallReceived(string callerConnectionId, string callerName)
    {
        return InvokeAsync(async () =>
        {
            await StopRingtone();
            _incomingCallerConnectionId = callerConnectionId;
            _incomingCallerName = callerName;
            _callStatus = null;
            await PlayRingtone();
            StateHasChanged();
        });
    }

    private Task VoiceCallCancelled(string callerConnectionId, bool timedOut)
    {
        return InvokeAsync(async () =>
        {
            if (_incomingCallerConnectionId != callerConnectionId) return;

            var callerName = _incomingCallerName;
            await ClearIncomingCall();
            _callStatus = timedOut
                ? callerName == null ? "Missed call" : $"Missed call from {callerName}"
                : callerName == null ? "Incoming call cancelled" : $"{callerName} stopped ringing";
            StateHasChanged();
        });
    }

    private Task VoiceCallResponded(string responderConnectionId, string responderName, bool accepted)
    {
        return InvokeAsync(() =>
        {
            if (_outgoingCallConnectionId != responderConnectionId) return;

            ClearOutgoingCall();
            _callStatus = accepted
                ? $"{responderName} accepted the call"
                : $"{responderName} declined the call";
            StateHasChanged();
        });
    }

    private async Task AcceptCall()
    {
        var callerConnectionId = _incomingCallerConnectionId;
        await ClearIncomingCall();
        if (callerConnectionId == null) return;

        if (!_joined)
        {
            await Join();
        }

        try
        {
            await SignalRStateManager.RespondVoiceCall(callerConnectionId, _joined);
            _callStatus = _joined ? "Call accepted" : "Unable to join the call";
        }
        catch (Exception exception)
        {
            _callStatus = "Call is no longer pending";
            _error = exception.Message;
        }
    }

    private async Task DeclineCall()
    {
        var callerConnectionId = _incomingCallerConnectionId;
        await ClearIncomingCall();
        if (callerConnectionId != null)
        {
            await SignalRStateManager.RespondVoiceCall(callerConnectionId, false);
        }
    }

    private async Task ClearIncomingCall()
    {
        await StopRingtone();
        _incomingCallerConnectionId = null;
        _incomingCallerName = null;
    }

    private async Task PlayRingtone()
    {
        await Js.InvokeVoidAsync("playAudio", _ringtone);
    }

    private async Task StopRingtone()
    {
        await Js.InvokeVoidAsync("stopAudio", _ringtone);
    }

    private async Task CheckTurnHealth()
    {
        _checkingTurn = true;
        try
        {
            _turnHealth = await SignalRStateManager.CheckTurnHealth();
        }
        finally
        {
            _checkingTurn = false;
        }
    }

    private async Task ToggleDebug()
    {
        if (_showDebug)
        {
            HideDebug();
            return;
        }

        _showDebug = true;
        StateHasChanged();
        await RefreshDebug();
    }

    private async Task RefreshDebug()
    {
        if (_module == null) return;

        var requestVersion = ++_debugRequestVersion;
        var debugInfo = await _module.InvokeAsync<string>("getConnectionDiagnostics");
        if (_showDebug && requestVersion == _debugRequestVersion)
        {
            _debugInfo = debugInfo;
        }
    }

    private void HideDebug()
    {
        _debugRequestVersion++;
        _showDebug = false;
        _sendMbps = 0;
        _receiveMbps = 0;
    }

    private async Task Leave()
    {
        await SignalRStateManager.LeaveVoice();
        await CleanupBrowserVoice();
    }

    private Task ReceiveVoiceOffer(string senderConnectionId, string offer)
    {
        return InvokeAsync(async () =>
        {
            if (!_joined || _module == null) return;
            _participantIds.Add(senderConnectionId);
            var senderName = State.OnlineUsers
                .FirstOrDefault(user => user.ConnectionId == senderConnectionId)?.Name
                ?? (_incomingCallerConnectionId == senderConnectionId ? _incomingCallerName : null)
                ?? "Participant";
            try
            {
                await _module.InvokeVoidAsync("receiveOffer", senderConnectionId, senderName, offer);
                _error = null;
            }
            catch (Exception exception)
            {
                _participantIds.Remove(senderConnectionId);
                _error = $"Unable to establish media bridge: {exception.Message}";
            }
            StateHasChanged();
        });
    }

    private Task ReceiveVoiceAnswer(string senderConnectionId, string answer)
    {
        return InvokeAsync(async () =>
        {
            if (_module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("receiveAnswer", senderConnectionId, answer);
                    _error = null;
                }
                catch (Exception exception)
                {
                    _participantIds.Remove(senderConnectionId);
                    await _module.InvokeVoidAsync("removeParticipant", senderConnectionId);
                    _error = $"Unable to establish media bridge: {exception.Message}";
                    StateHasChanged();
                }
            }
        });
    }

    private Task ReceiveVoiceIceCandidate(string senderConnectionId, string candidate)
