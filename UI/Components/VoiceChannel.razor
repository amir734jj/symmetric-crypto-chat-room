    private async Task PlayRingtone()
    {
        var requestId = ++_ringtoneRequestId;
        var module = await (_ringtoneModuleTask ??= Js.InvokeAsync<IJSObjectReference>(
            "import", "./js/ringtone.js").AsTask());
        if (requestId != _ringtoneRequestId || _incomingCallerConnectionId == null) return;
        await module.InvokeVoidAsync("playRingtone", _ringtone);
    }

    private async Task StopRingtone()
    {
        _ringtoneRequestId++;
        if (_ringtoneModuleTask?.IsCompletedSuccessfully == true)
        {
            var module = await _ringtoneModuleTask;
            await module.InvokeVoidAsync("stopRingtone");
        }
    }

    private async Task TestBrowserRelay()
    {
        _checkingBrowserTurn = true;
        _browserTurnResult = null;
        _browserTurnError = null;
        try
        {
            var credentials = await SignalRStateManager.GetTurnCredentials();
            if (_disposed) return;
            _turnDiagnosticsModule ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./js/turn-diagnostics.js");
            if (_disposed)
            {
                await _turnDiagnosticsModule.DisposeAsync();
                return;
            }
            var result = await _turnDiagnosticsModule.InvokeAsync<TurnConnectionTestResult>(
                "testTurnConnection", credentials);
            if (!_disposed) _browserTurnResult = result;
        }
        catch (Exception exception) when (exception is JSException
            or Microsoft.AspNetCore.SignalR.HubException or InvalidOperationException)
        {
            if (!_disposed) _browserTurnError = $"Unable to test the browser relay: {exception.Message}";
        }
        finally
        {
            _checkingBrowserTurn = false;
        }
    }

