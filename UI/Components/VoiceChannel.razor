    private async Task Ring(OnlineUser user)
    {
        _callStatus = null;
        try
        {
            _outgoingCallConnectionId = user.ConnectionId;
            _outgoingCallName = user.Name;
            _callStatus = $"Ringing {user.Name}... (30 seconds)";
            StartOutgoingCallTimeout(user.ConnectionId, user.Name);
            await SignalRStateManager.RingVoice(user.ConnectionId);
        }
        catch (Exception exception)
        {
            if (_outgoingCallConnectionId == user.ConnectionId)
            {
                ClearOutgoingCall();
                _callStatus = null;
            }
            _error = $"Unable to ring {user.Name}: {exception.Message}";
        }
    }

    private async Task StopRinging()
    {
        var targetConnectionId = _outgoingCallConnectionId;
        var targetName = _outgoingCallName;
        if (targetConnectionId == null) return;

        try
        {
            await SignalRStateManager.CancelVoiceCall(targetConnectionId);
        }
        catch
        {
        }
        finally
        {
            ClearOutgoingCall();
        }

        _callStatus = targetName == null ? "Call cancelled" : $"Stopped ringing {targetName}";
    }

    private void StartOutgoingCallTimeout(string targetConnectionId, string targetName)
    {
        _outgoingCallTimeoutCancellation?.Cancel();
        _outgoingCallTimeoutCancellation?.Dispose();
        _outgoingCallTimeoutCancellation = new CancellationTokenSource();
        _ = StopRingingAfterTimeout(targetConnectionId, targetName, _outgoingCallTimeoutCancellation.Token);
    }

    private async Task StopRingingAfterTimeout(
        string targetConnectionId,
        string targetName,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(RingTimeout, cancellationToken);
            await InvokeAsync(async () =>
            {
                if (_outgoingCallConnectionId != targetConnectionId) return;

                await SignalRStateManager.CancelVoiceCall(targetConnectionId, true);
                if (_outgoingCallConnectionId != targetConnectionId || cancellationToken.IsCancellationRequested) return;
                ClearOutgoingCall();
                _callStatus = $"{targetName} did not answer";
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                if (_outgoingCallConnectionId != targetConnectionId || cancellationToken.IsCancellationRequested) return;
                ClearOutgoingCall();
                _callStatus = "Unable to cancel the unanswered call";
                _error = exception.Message;
                StateHasChanged();
            });
        }
    }

    private void ClearOutgoingCall()
    {
        _outgoingCallTimeoutCancellation?.Cancel();
        _outgoingCallTimeoutCancellation?.Dispose();
        _outgoingCallTimeoutCancellation = null;
        _outgoingCallConnectionId = null;
        _outgoingCallName = null;
    }

    private Task VoiceCallReceived(string callerConnectionId, string callerName)
    {
        return InvokeAsync(async () =>
        {
            _incomingCallerConnectionId = callerConnectionId;
            _incomingCallerName = callerName;
            _callStatus = null;
            StateHasChanged();
            await PlayRingtone();
        });
    }

    private Task VoiceCallCancelled(string callerConnectionId, bool timedOut)
    {
        return InvokeAsync(async () =>
        {
            if (_incomingCallerConnectionId != callerConnectionId) return;

            var callerName = _incomingCallerName;
            await ClearIncomingCall();
            _callStatus = timedOut
                ? callerName == null ? "Missed call" : $"Missed call from {callerName}"
                : callerName == null ? "Incoming call cancelled" : $"{callerName} stopped ringing";
            StateHasChanged();
        });
    }

    private Task VoiceCallResponded(string responderConnectionId, string responderName, bool accepted)
    {
        return InvokeAsync(() =>
        {
            if (_outgoingCallConnectionId != responderConnectionId) return;

            ClearOutgoingCall();
            _callStatus = accepted
                ? $"{responderName} accepted the call"
                : $"{responderName} declined the call";
            StateHasChanged();
        });
    }

    private async Task AcceptCall()
    {
        var callerConnectionId = _incomingCallerConnectionId;
        await ClearIncomingCall();
        if (callerConnectionId == null) return;

        try
        {
            await SignalRStateManager.RespondVoiceCall(callerConnectionId, true);
        }
        catch (Exception exception)
        {
            _callStatus = "Call is no longer pending";
            _error = exception.Message;
            return;
        }

        _callStatus = "Call accepted - connecting...";
        if (!_joined)
        {
            await Join();
        }
        _callStatus = _joined ? "Call accepted" : "Unable to join the call";
    }

    private async Task DeclineCall()
    {
        var callerConnectionId = _incomingCallerConnectionId;
        await ClearIncomingCall();
        if (callerConnectionId != null)
        {
            await SignalRStateManager.RespondVoiceCall(callerConnectionId, false);
        }
    }

    private async Task ClearIncomingCall()
    {
        _incomingCallerConnectionId = null;
