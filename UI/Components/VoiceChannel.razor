@using Models
@inject SignalRStateManager SignalRStateManager
@inject State State
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="voice-channel mb-3" aria-label="Voice channel">
    <div class="voice-channel-header">
        <div class="voice-channel-title">
            <strong>Voice channel</strong>
            @if (_joined)
            {
                <span class="ms-2 text-muted">@(_participantIds.Count + 1) connected</span>
            }
        </div>

        <div class="voice-channel-actions">
            <HxButton Color="@TurnHealthColor" Enabled="@(!_checkingTurn)" OnClick="CheckTurnHealth">
                @TurnHealthButtonText
            </HxButton>
            @if (!_joined)
            {
                <HxButton Color="ThemeColor.Success" Enabled="@(!_busy)" OnClick="Join">
                    Join voice
                </HxButton>
            }
            else
            {
                <HxButton Color="ThemeColor.Secondary" OnClick="ToggleMute">
                    @(_muted ? "Unmute" : "Mute")
                </HxButton>
                <HxButton Color="ThemeColor.Secondary" OnClick="ShowDebug">
                    ICE debug
                </HxButton>
                <HxButton Color="ThemeColor.Danger" OnClick="Leave">
                    Leave voice
                </HxButton>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="text-danger mt-2" role="alert">@_error</div>
    }

    @if (_turnHealth != null)
    {
        <div class="@TurnHealthMessageCssClass" role="status">
            @_turnHealth.Host:@_turnHealth.Port - @_turnHealth.Message
        </div>
    }

    @if (_showDebug)
    {
        <div class="voice-debug mt-3">
            <div class="voice-debug-header">
                <strong>ICE connection details</strong>
                <div>
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="ShowDebug">
                        Refresh
                    </HxButton>
                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" OnClick="HideDebug">
                        Hide
                    </HxButton>
                </div>
            </div>
            <pre class="mt-2 mb-0">@_debugInfo</pre>
        </div>
    }

    <div @ref="_remoteAudioContainer"></div>
</section>

@code {
    private readonly HashSet<string> _participantIds = [];
    private DotNetObjectReference<VoiceChannel>? _reference;
    private IJSObjectReference? _module;
    private ElementReference _remoteAudioContainer;
    private bool _joined;
    private bool _muted;
    private bool _busy;
    private bool _checkingTurn;
    private bool _showDebug;
    private string? _error;
    private string? _debugInfo;
    private TurnHealthStatus? _turnHealth;

    private ThemeColor TurnHealthColor => _turnHealth switch
    {
        { Healthy: true } => ThemeColor.Success,
        { Healthy: false } => ThemeColor.Danger,
        _ => ThemeColor.Secondary
    };

    private string TurnHealthButtonText => _checkingTurn
        ? "Checking STUN/TURN..."
        : _turnHealth switch
        {
            { Healthy: true } => "STUN/TURN healthy",
            { Healthy: false } => "STUN/TURN unavailable",
            _ => "Check STUN/TURN"
        };

    private string TurnHealthMessageCssClass => _turnHealth?.Healthy == true
        ? "voice-health-message mt-2 text-success"
        : "voice-health-message mt-2 text-danger";

    protected override void OnInitialized()
    {
        SignalRStateManager.VoiceOfferReceived += ReceiveVoiceOffer;
        SignalRStateManager.VoiceAnswerReceived += ReceiveVoiceAnswer;
        SignalRStateManager.VoiceIceCandidateReceived += ReceiveVoiceIceCandidate;
        SignalRStateManager.VoiceParticipantLeftReceived += VoiceParticipantLeft;
        SignalRStateManager.ConnectionReconnected += ConnectionReconnected;
    }

    private Task ConnectionReconnected()
    {
        return InvokeAsync(async () =>
        {
            if (!_joined) return;

            await CleanupBrowserVoice();
            await Join();
            StateHasChanged();
        });
    }

    private async Task Join()
    {
        _busy = true;
        _error = null;

        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/voice-chat.js");
            _reference ??= DotNetObjectReference.Create(this);

            var turnCredentials = await SignalRStateManager.GetTurnCredentials();
            var userInfo = State.UserInfo ?? throw new InvalidOperationException("Chat session is not available");
            var voiceKey = Convert.ToBase64String(HashingUtility.DeriveVoiceKey(userInfo.Password, userInfo.Channel));
            await _module.InvokeVoidAsync(
                "initialize",
                _reference,
                _remoteAudioContainer,
                turnCredentials,
                voiceKey);

            var participants = await SignalRStateManager.JoinVoice();
            _joined = true;
            _participantIds.UnionWith(participants.Select(participant => participant.ConnectionId));
            await _module.InvokeVoidAsync(
                "connectToParticipants",
                (object)participants.Select(participant => participant.ConnectionId).ToArray());
        }
        catch (Exception exception)
        {
            _error = $"Unable to join voice: {exception.Message}";
            if (_joined)
            {
                await SignalRStateManager.LeaveVoice();
            }
            await CleanupBrowserVoice();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMute()
    {
        _muted = !_muted;
        await _module!.InvokeVoidAsync("setMuted", _muted);
    }

    private async Task CheckTurnHealth()
    {
        _checkingTurn = true;
        try
        {
            _turnHealth = await SignalRStateManager.CheckTurnHealth();
        }
        finally
        {
            _checkingTurn = false;
        }
    }

    private async Task ShowDebug()
    {
        if (_module == null) return;

        _debugInfo = await _module.InvokeAsync<string>("getConnectionDiagnostics");
        _showDebug = true;
    }

    private void HideDebug()
    {
        _showDebug = false;
    }

    private async Task Leave()
    {
        await SignalRStateManager.LeaveVoice();
        await CleanupBrowserVoice();
    }

    private Task ReceiveVoiceOffer(string senderConnectionId, string offer)
    {
        return InvokeAsync(async () =>
        {
            if (!_joined || _module == null) return;
            _participantIds.Add(senderConnectionId);
            await _module.InvokeVoidAsync("receiveOffer", senderConnectionId, offer);
            StateHasChanged();
        });
    }

    private Task ReceiveVoiceAnswer(string senderConnectionId, string answer)
    {
        return InvokeAsync(async () =>
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("receiveAnswer", senderConnectionId, answer);
            }
        });
    }

    private Task ReceiveVoiceIceCandidate(string senderConnectionId, string candidate)
    {
        return InvokeAsync(async () =>
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("receiveIceCandidate", senderConnectionId, candidate);
            }
        });
    }

    private Task VoiceParticipantLeft(string connectionId)
    {
        return InvokeAsync(async () =>
        {
            _participantIds.Remove(connectionId);
            if (_module != null)
            {
                await _module.InvokeVoidAsync("removeParticipant", connectionId);
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public Task SendVoiceOffer(string targetConnectionId, string offer)
    {
        return SignalRStateManager.SendVoiceOffer(targetConnectionId, offer);
    }

    [JSInvokable]
    public Task SendVoiceAnswer(string targetConnectionId, string answer)
    {
        return SignalRStateManager.SendVoiceAnswer(targetConnectionId, answer);
    }

    [JSInvokable]
    public Task SendVoiceIceCandidate(string targetConnectionId, string candidate)
    {
        return SignalRStateManager.SendVoiceIceCandidate(targetConnectionId, candidate);
    }

    private async Task CleanupBrowserVoice()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("leave");
        }

        _participantIds.Clear();
        _joined = false;
        _muted = false;
        _showDebug = false;
        _debugInfo = null;
    }

    public async ValueTask DisposeAsync()
    {
        SignalRStateManager.VoiceOfferReceived -= ReceiveVoiceOffer;
        SignalRStateManager.VoiceAnswerReceived -= ReceiveVoiceAnswer;
        SignalRStateManager.VoiceIceCandidateReceived -= ReceiveVoiceIceCandidate;
        SignalRStateManager.VoiceParticipantLeftReceived -= VoiceParticipantLeft;
        SignalRStateManager.ConnectionReconnected -= ConnectionReconnected;

        if (_joined)
        {
            await SignalRStateManager.LeaveVoice();
        }

        await CleanupBrowserVoice();
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}