    [JSInvokable]
    public Task TranscriptionTextReceived(string text)
    {
        return InvokeAsync(() =>
        {
            if (!_transcriptionEnabled || string.IsNullOrWhiteSpace(text)) return;

            _transcript.Add(text.Trim());
            while (_transcript.Count > 100)
            {
                _transcript.RemoveAt(0);
            }
            StateHasChanged();
        });
    }

