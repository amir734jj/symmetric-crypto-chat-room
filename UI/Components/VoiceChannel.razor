    private bool QueueWebRtcSignal(string kind, string sender, string payload)
    {
        if (_webRtcReady || _useHttpsAudio || (!_joined && !_joiningAutomatic)) return false;
        if (_pendingWebRtcSignals.Count >= 64)
        {
            _error = "Too many pending WebRTC signals; leave and rejoin the call.";
            Logger.LogWarning("Rejected excessive pending WebRTC signals");
            StateHasChanged();
            return true;
        }
        _pendingWebRtcSignals.Enqueue((kind, sender, payload));
        return true;
    }

    private Task ReceiveVoiceOffer(string senderConnectionId, string offer)
    {
        return InvokeAsync(async () =>
        {
            if (QueueWebRtcSignal("offer", senderConnectionId, offer)) return;
            if (!_joined || _useHttpsAudio || _module == null) return;
            _participantIds.Add(senderConnectionId);
            var senderName = State.OnlineUsers
                .FirstOrDefault(user => user.ConnectionId == senderConnectionId)?.Name
                ?? (_incomingCallerConnectionId == senderConnectionId ? _incomingCallerName : null)
                ?? "Participant";
            try
            {
                await _module.InvokeVoidAsync("receiveOffer", senderConnectionId, senderName, offer);
                _error = null;
            }
            catch (Exception exception)
            {
                _participantIds.Remove(senderConnectionId);
                _error = $"Unable to establish media bridge: {exception.Message}";
            }
            StateHasChanged();
        });
    }

    private Task ReceiveVoiceAnswer(string senderConnectionId, string answer)
    {
        return InvokeAsync(async () =>
        {
            if (QueueWebRtcSignal("answer", senderConnectionId, answer)) return;
            if (!_useHttpsAudio && _module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("receiveAnswer", senderConnectionId, answer);
                    _error = null;
                }
                catch (Exception exception)
                {
                    _participantIds.Remove(senderConnectionId);
                    await _module.InvokeVoidAsync("removeParticipant", senderConnectionId);
                    _error = $"Unable to establish media bridge: {exception.Message}";
                    StateHasChanged();
                }
            }
        });
    }

    private Task ReceiveVoiceIceCandidate(string senderConnectionId, string candidate)
