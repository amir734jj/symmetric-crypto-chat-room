<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BlazorDownloadFile" Version="2.4.0.2" />
        <PackageReference Include="Blazored.SessionStorage" Version="2.4.0" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="CaseExtensions" Version="1.1.0" />
        <PackageReference Include="CurrieTechnologies.Razor.PageVisibility" Version="1.0.0" />
        <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" Version="4.26.1" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.8" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.8" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="TypedSignalR.Client" Version="3.6.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Models\Models.csproj" />
    </ItemGroup>

    <Target Name="PrepareVersionedCallAssets" BeforeTargets="GetAssemblyAttributes;ResolveProjectStaticWebAssets">
        <ItemGroup>
            <_CallAsset Include="wwwroot\js\**\*" />
        </ItemGroup>
        <GetFileHash Files="@(_CallAsset)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_HashedCallAsset" />
        </GetFileHash>
        <WriteLinesToFile File="$(IntermediateOutputPath)call-assets.hashes"
                          Lines="@(_HashedCallAsset->'%(Identity)=%(FileHash)')"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <GetFileHash Files="$(IntermediateOutputPath)call-assets.hashes" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_CallAssetVersionFile" />
        </GetFileHash>
        <PropertyGroup>
            <_CallAssetVersion>@(_CallAssetVersionFile->'%(FileHash)')</_CallAssetVersion>
            <_CallAssetDirectory>$(IntermediateOutputPath)call-assets\$(_CallAssetVersion)\</_CallAssetDirectory>
        </PropertyGroup>
        <Copy SourceFiles="@(_CallAsset)"
              DestinationFiles="@(_CallAsset->'$(_CallAssetDirectory)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <ItemGroup>
            <_GeneratedCallAsset Include="$(_CallAssetDirectory)**\*" />
            <Content Include="@(_GeneratedCallAsset)">
                <Link>wwwroot\js\call\$(_CallAssetVersion)\%(_GeneratedCallAsset.RecursiveDir)%(_GeneratedCallAsset.Filename)%(_GeneratedCallAsset.Extension)</Link>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </Content>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CallAssetVersion</_Parameter1>
                <_Parameter2>$(_CallAssetVersion)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

</Project>
