FROM coturn/coturn:4.6.3

ENV TURN_REALM=chat.coolify.hesamian.com \
    TURN_MIN_PORT=49160 \
    TURN_MAX_PORT=49200 \
    TURN_LISTENING_PORT=3478 \
    TURN_TLS_PORT=443 \
    TURN_TLS_ONLY=false \
    TURN_TLS_CERT_FILE=/etc/coturn/certs/fullchain.pem \
    TURN_TLS_KEY_FILE=/etc/coturn/certs/privkey.pem

EXPOSE 443/tcp 3478/tcp 3478/udp 49160-49200/udp

COPY scripts/start-turn.sh /usr/local/bin/start-turn.sh

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD turnutils_stunclient -p "$TURN_LISTENING_PORT" 127.0.0.1 || exit 1

ENTRYPOINT ["/bin/sh", "/usr/local/bin/start-turn.sh"]
